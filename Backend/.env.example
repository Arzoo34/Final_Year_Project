PORT=3001
MQTT_PORT=1883
MQTT_BROKER=mqtt://127.0.0.1:1883
FRONTEND_URL=http://localhost:3001
NODE_ENV=production

# Telemetry mode:
# - DUMMY_MODE=true  (default): backend updates dummy workers/anchors every 3s (no MQTT broker)
# - DUMMY_MODE=false: enable MQTT broker + use MQTT-based simulator (for lora-gateway.js)
DUMMY_MODE=true

# ESP32 / hardware POST /api/telemetry: worker ID that must NOT be overwritten by the dummy engine (e.g. first miner MNR-001). Leave unset to simulate all 12 workers.
# HARDWARE_TELEMETRY_WORKER=MNR-001
# Optional: force every HTTP telemetry body onto this worker (if firmware omits worker_id).
# TELEMETRY_FORCE_WORKER_ID=MNR-001

# How often the same alert (same worker + same title) can be inserted into DB
# while the condition persists.
ALERT_TTL_MS=60000

# Groq API Key — chatbot and dashboard AI (https://console.groq.com/keys) — DO NOT COMMIT REAL KEYS
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional model (default: llama-3.3-70b-versatile). See https://console.groq.com/docs/deprecations
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: AI_PROVIDER=claude to use Anthropic when GROQ_API_KEY is unset (advanced)

# ── API authentication (optional) ─────────────────────────────
# When AUTH_ENABLED=true, all /api/* routes require Authorization: Bearer <JWT>
# except: /api/health, /api/telemetry, /api/wristband, /api/auth/login, /api/auth/register, /api/auth/public-config
#
# Supabase (login.html / signup.html + Bearer on API calls):
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_ANON_KEY=eyJ... or sb_publishable_... (public — safe for browser via /api/auth/public-config)
#   SUPABASE_SECRET_KEY=sb_secret_... (optional; server-only — never exposed by SafeMine; for future admin SDK use)
#   SUPABASE_JWT_SECRET=...    (Dashboard → Project Settings → API → JWT Secret — verifies access_token)
# With SUPABASE_JWT_SECRET set, the API gate accepts Supabase access tokens only (not SQLite JWT).
#
# SQLite-only /api/auth/register + /api/auth/login (no Supabase UI):
#   JWT_SECRET=use-a-long-random-string-at-least-16-chars
#
# AUTH_ENABLED=false
# JWT_EXPIRES_IN=7d
